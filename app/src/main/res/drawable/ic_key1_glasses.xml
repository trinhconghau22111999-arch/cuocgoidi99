<?xml version="1.0" encoding="utf-8"?>
<!-- Icon "mắt kính" cho nhãn phụ dưới phím 1 (hộp thư thoại): 2 vòng tròn RỖNG nối với nhau
     bằng 1 thanh cầu ngang Ở PHÍA DƯỚI (không phải xuyên giữa như gọng kính thường), đúng
     mô tả người dùng yêu cầu. Trước đó dùng #C4C7CC (xám NHẠT hơn) tưởng là sẽ "sáng" hơn,
     nhưng trên nền TRẮNG màu càng nhạt thì độ tương phản càng THẤP -> icon trông mờ/tối hơn
     hẳn so với chữ ABC/DEF... (dùng đúng màu text_secondary #5F6368). Giờ đổi lại đúng màu
     text_secondary #5F6368 + tăng nét dày hơn (3.0) để bù độ "mỏng" của viền tròn so với
     chữ đặc, cho độ sáng/độ nổi bật cảm nhận bằng nhau. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp" android:height="9dp"
    android:viewportWidth="32" android:viewportHeight="14">
    <!-- Tròng kính trái -->
    <path
        android:strokeColor="#5F6368"
        android:strokeWidth="3.0"
        android:fillColor="#00000000"
        android:pathData="M7,2 A5,5 0 1,0 7,12 A5,5 0 1,0 7,2 Z" />
    <!-- Tròng kính phải -->
    <path
        android:strokeColor="#5F6368"
        android:strokeWidth="3.0"
        android:fillColor="#00000000"
        android:pathData="M25,2 A5,5 0 1,0 25,12 A5,5 0 1,0 25,2 Z" />
    <!-- Cầu nối Ở PHÍA DƯỚI 2 tròng kính (gần đáy vòng tròn) -->
    <path
        android:strokeColor="#5F6368"
        android:strokeWidth="3.0"
        android:strokeLineCap="round"
        android:pathData="M12,11 L20,11" />
</vector>
