<?xml version="1.0" encoding="utf-8"?>
<!-- Nền màn hình gọi kiểu ảnh nền mờ (blurred wallpaper) - dải màu xám sáng, đậm nhẹ ở giữa,
     sáng dần ra 2 đầu trên/dưới, giống ảnh mẫu thực tế người dùng cung cấp (không phải màu
     đơn sắc tối như trước). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#9B9FA2"
        android:centerColor="#6C7175"
        android:endColor="#AAABAD" />
</shape>
